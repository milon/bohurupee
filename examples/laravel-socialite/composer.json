{
  "name": "bohurupee/laravel-socialite-example",
  "description": "Minimal Laravel app that logs in through local Bohurupee via Socialite",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0 || ^13.0",
    "laravel/socialite": "^5.16",
    "milon/bohurupee-laravel": "@dev"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../bohurupee-laravel"
    }
  ],
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
